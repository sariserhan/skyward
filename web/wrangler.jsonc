{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyward",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern":"skyvvard.com","custom_domain":true},{"pattern":"www.skyvvard.com","custom_domain":true}],
  "assets": {"directory":".cloudflare/assets","binding":"ASSETS","run_worker_first":["/api/*","/watch/models/*","/watch","/watch/","/watch/index.html"],"not_found_handling":"none"},
  "d1_databases": [{"binding":"DB","database_name":"skyward-accounts","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"cloudflare/migrations"}],
  "r2_buckets": [{"binding":"MEDIA","bucket_name":"skyward-assets"}],
  "durable_objects": {"bindings":[{"name":"COORDINATOR","class_name":"SkywardCoordinator"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["SkywardCoordinator"]}],
  "triggers": {"crons":["17 3 * * *"]},
  "vars": {
    "NODE_ENV":"production",
    "SKYWARD_PUBLIC_ORIGIN":"https://skyvvard.com",
    "SKYWARD_ACCOUNTS":"d1",
    "SKYWARD_BILLING_MODE":"test",
    "SKYWARD_AIRLABS_MODE":"demo",
    "SKYWARD_EMAIL_PROVIDER":"resend",
    "RESEND_FROM":"Skyward <contact@skyvvard.com>",
    "RESEND_REPLY_TO":"support@skyvvard.com",
    "SKYWARD_DYNAMIC_DAILY_LIMIT":"50000",
    "SKYWARD_ASSET_RELEASE":""
  },
  "observability": {"enabled":false}
}
