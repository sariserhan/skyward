# Local Wrangler only. Copy to .dev.vars; never commit real secrets.
SKYWARD_PUBLIC_ORIGIN=http://localhost:8787
BETTER_AUTH_SECRET=
RESEND_API_KEY=
# Real email is sent when a real key is supplied; use a verified sending domain.
RESEND_FROM=Skyward <contact@skyvvard.com>
RESEND_REPLY_TO=support@skyvvard.com
# Optional existing provider/audio keys stay server-side.
# SKYWARD_FLYITALY_API_KEY=
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=
# Optional Stripe TEST setup; annual recurring price only.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_ANNUAL_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
