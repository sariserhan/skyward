{
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "better-auth": "1.7.6",
    "cesium": "1.145.0",
    "lucide-react": "1.48.0",
    "nodemailer": "10.0.12",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "name": "skyward-observatory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/copy-cesium.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run prepare:assets && node scripts/prepare-coverage.mjs && tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "prepare:fleet": "python3 scripts/make-aircraft.py",
    "import:aircraft": "node scripts/import-aircraft-models.mjs",
    "prepare:branding": "node scripts/brand-aircraft-tails.mjs",
    "import:liveries": "node scripts/import-liveries.mjs",
    "test:browser": "npm run build && node scripts/browser-tests.mjs",
    "test:soak": "npm run build && node scripts/browser-tests.mjs --soak",
    "import:max": "python3 scripts/import-max-models.py",
    "import:flightairmap": "node scripts/import-flightairmap-models.mjs",
    "import:business": "python3 scripts/import-business-models.py",
    "prepare:aircraft-lights": "node scripts/prepare-aircraft-lights.mjs",
    "import:airport-elevations": "python3 scripts/import-airport-elevations.py",
    "check:airlabs": "node scripts/check-airlabs.mjs",
    "start:airlabs-demo": "SKYWARD_AIRLABS_MODE=demo node server/index.mjs",
    "start:premium-test": "SKYWARD_ACCOUNTS=test node server/index.mjs",
    "premium:usage": "node --env-file-if-exists=.env scripts/premium-usage.mjs",
    "test:views": "npm run build && node scripts/browser-tests.mjs --views",
    "test:customer": "npm run build && node scripts/browser-tests.mjs --customer",
    "test:launch": "npm test && npm run test:browser && npm run test:customer",
    "test:landing": "npm run build && node scripts/browser-tests.mjs --landing",
    "premium:test": "node scripts/test-premium.mjs",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-neon.mjs",
    "start:neon": "SKYWARD_ACCOUNTS=neon node --env-file-if-exists=.env server/index.mjs",
    "test:neon": "node --test server/neon-membership.test.mjs",
    "push:keys": "web-push generate-vapid-keys --json"
  }
}
