{
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "@stripe/stripe-js": "^9.17.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "astronomy-engine": "2.1.19",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.6",
    "cesium": "1.145.0",
    "lucide-react": "1.48.0",
    "nodemailer": "10.0.12",
    "pbf": "5.1.2",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "^4.144.0"
  },
  "name": "skyward-observatory",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "audit:taxi": "node scripts/audit-taxi-routes.mjs",
    "prepare:assets": "node scripts/copy-cesium.mjs",
    "predev": "npm run prepare:assets",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run prepare:assets && node scripts/prepare-airframes.mjs && node scripts/prepare-coverage.mjs && node scripts/prepare-airport-assets.mjs && tsc -b && vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "prepare:fleet": "python3 scripts/make-aircraft.py",
    "import:aircraft": "node scripts/import-aircraft-models.mjs",
    "prepare:branding": "node scripts/brand-aircraft-tails.mjs",
    "import:liveries": "node scripts/import-liveries.mjs",
    "test:browser": "npm run build && node scripts/browser-tests.mjs",
    "test:soak": "npm run build && node scripts/browser-tests.mjs --soak",
    "import:max": "python3 scripts/import-max-models.py",
    "import:flightairmap": "node scripts/import-flightairmap-models.mjs",
    "import:business": "python3 scripts/import-business-models.py",
    "prepare:aircraft-lights": "node scripts/prepare-aircraft-lights.mjs",
    "import:airport-elevations": "python3 scripts/import-airport-elevations.py",
    "check:airlabs": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-airlabs.mjs",
    "start:airlabs-demo": "SKYWARD_AIRLABS_MODE=demo node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "start:premium-test": "SKYWARD_ACCOUNTS=test node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "premium:usage": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/premium-usage.mjs",
    "test:flight-cadence": "npm run build && node scripts/browser-tests.mjs --flight-cadence",
    "test:views": "npm run build && node scripts/browser-tests.mjs --views",
    "test:customer": "npm run build && node scripts/browser-tests.mjs --customer",
    "test:launch": "npm test && npm run test:browser && npm run test:customer",
    "test:landing": "npm run build && node scripts/browser-tests.mjs --landing",
    "premium:test": "node scripts/test-premium.mjs",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-neon.mjs",
    "start:neon": "SKYWARD_ACCOUNTS=neon node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "test:neon": "node --test server/neon-membership.test.mjs",
    "push:keys": "web-push generate-vapid-keys --json",
    "start:dev": "NODE_ENV=development SKYWARD_DEV_PREMIUM=1 SKYWARD_ACCOUNTS=test node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "start:neon:dev": "NODE_ENV=development SKYWARD_DEV_PREMIUM=1 SKYWARD_ACCOUNTS=neon node --env-file-if-exists=.env --env-file-if-exists=.env.local server/index.mjs",
    "test:weather": "npm run build && node scripts/browser-tests.mjs --weather",
    "test:cockpit": "npm run build && node scripts/browser-tests.mjs --cockpit",
    "check:flyitaly": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-flyitaly.mjs",
    "test:architecture": "npm run build && node scripts/browser-tests.mjs --architecture",
    "test:release": "node scripts/release-check.mjs",
    "test:visual": "npm run build && node scripts/browser-tests.mjs --visual-tour",
    "test:account-recovery": "npm run build && node scripts/browser-tests.mjs --account-recovery",
    "test:scenery": "npm run build && node scripts/browser-tests.mjs --scenery",
    "test:devices": "npm run build && node scripts/device-release.mjs",
    "test:performance": "npm run build && node scripts/browser-tests.mjs --performance-capture",
    "import:facilities": "python3 scripts/import-airport-facilities.py",
    "test:facilities": "python3 -m unittest discover -s scripts -p test_airport_facilities.py",
    "build:cloudflare": "npm run build && node scripts/prepare-cloudflare.mjs",
    "dev:cloudflare": "wrangler dev --local",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .cloudflare/worker",
    "db:migrate:d1:local": "wrangler d1 migrations apply skyward-accounts --local",
    "assets:r2:plan": "node scripts/upload-cloudflare-assets.mjs",
    "check:stripe": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-stripe.mjs",
    "check:launch": "node scripts/check-launch.mjs",
    "catalog:check": "node scripts/prepare-airframes.mjs",
    "catalog:import": "node scripts/import-airframes.mjs",
    "check:free-budget": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/check-free-budget.mjs"
  }
}
