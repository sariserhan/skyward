# Copy to web/.env; keep credentials out of git and the browser.
SKYWARD_ACCOUNTS=neon
# Local browser / SSH forwarding origin must match exactly.
SKYWARD_PUBLIC_ORIGIN=http://localhost:8000
# Neon Console -> Connect: pooled connection for runtime; direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require
# Optional direct (non-pooler) connection for migrations:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
# Generate with: openssl rand -hex 48
BETTER_AUTH_SECRET=
SKYWARD_DB_POOL_SIZE=5
# Verification/recovery email is required. Use a verified sender you control.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# No real payments or live premium lookups are enabled by this integration.
# Optional Stripe sandbox values only:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# Optional Web Push. Generate your own pair with npm run push:keys.
# Keep the private key server-only; use your real HTTPS origin as the subject.
# SKYWARD_VAPID_PUBLIC_KEY=
# SKYWARD_VAPID_PRIVATE_KEY=
# SKYWARD_VAPID_SUBJECT=https://YOUR-DOMAIN

# Optional ADSBHub aggregate: leave off until a real receiver contributes and
# this application's public IP is authorized. See ../ops/adsbhub/README.md.
SKYWARD_ADSBHUB_ENABLED=0
# SKYWARD_ADSBHUB_ACCESS=confirmed
# SKYWARD_ADSBHUB_TIMESTAMPS=UTC
# Optional ADSB.fi: requires commercial permission and verified endpoint access.
SKYWARD_ADSBFI_ENABLED=0
# SKYWARD_ADSBFI_COMMERCIAL_PERMISSION=confirmed
