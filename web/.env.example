# Copy to web/.env.local; keep credentials out of git and the browser.
# Server npm commands load .env, then .env.local; exported shell values win.
SKYWARD_ACCOUNTS=neon
# Local browser / SSH forwarding origin must match exactly.
SKYWARD_PUBLIC_ORIGIN=http://localhost:8000
# Neon Console -> Connect: pooled connection for runtime; direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.neon.tech/neondb?sslmode=require
# Optional direct (non-pooler) connection for migrations:
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.neon.tech/neondb?sslmode=require
# Generate with: openssl rand -hex 48
BETTER_AUTH_SECRET=
SKYWARD_DB_POOL_SIZE=5
# Production canonical origin: https://skyvvard.com
SKYWARD_EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=Skyward <contact@skyvvard.com>
RESEND_REPLY_TO=support@skyvvard.com
# Optional legacy SMTP fallback: unset SKYWARD_EMAIL_PROVIDER to use it.
# Verification/recovery email is required. Use a verified sender you control.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# No real payments or live premium lookups are enabled by this integration.
# Optional Stripe sandbox values only:
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# Optional Web Push. Generate your own pair with npm run push:keys.
# Keep the private key server-only; use your real HTTPS origin as the subject.
# SKYWARD_VAPID_PUBLIC_KEY=
# SKYWARD_VAPID_PRIVATE_KEY=
# SKYWARD_VAPID_SUBJECT=https://YOUR-DOMAIN

# Optional free supplemental observations. Obtain a free key at:
# https://flyitalyadsb.com/en/dati/api/
# Server-only; never use a VITE_ prefix or commit a real key.
SKYWARD_FLYITALY_API_KEY=
# Set to 0 to disable without deleting the key. With a key, enabled by default.
SKYWARD_FLYITALY_ENABLED=1

# Optional private operational metrics: generate at least 24 random characters.
# SKYWARD_METRICS_TOKEN=
# Only enable when a reverse proxy connects through loopback and sets X-Forwarded-For.
# SKYWARD_TRUST_LOOPBACK_PROXY=1

# Aurowall music library — server-only credentials, never VITE_ variables.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
# Optional folder restriction for a shared bucket, for example audio/
AUROWALL_AUDIO_PREFIX=

# Optional production billing. Defaults to test. Do not enable during development.
SKYWARD_BILLING_MODE=test
# Live details additionally require SKYWARD_ACCOUNTS=neon,
# SKYWARD_AIRLABS_MODE=live, AIRLABS_API_KEY, live Stripe credentials,
# a verified paid subscription and remaining shared/account budget.
# See docs/premium-live-service.md. No new credentials belong in VITE_* variables.

# Optional public static/R2 custom-domain prefix for airport JSON (build-time).
# Leave empty to use bundled local assets; never place credentials here.
VITE_AIRPORT_ASSET_BASE_URL=
# Embedded annual subscriptions. Match all keys/prices to the selected billing mode.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_PRICE_ANNUAL_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID remains an alias for the annual price; monthly prices are rejected.
